FROM golang:1.26-alpine AS builder
WORKDIR /app
ARG VERSION
ENV GOPROXY=https://goproxy.cn
COPY go.mod go.sum ./
COPY . .
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X 'main.version=${VERSION}'" -o upgrade ./cmd/upgrade

FROM alpine:3.20
LABEL MAINTAINER="PIXIU"
ARG TARGETARCH
ARG NERDCTL_VERSION=2.4.0
# 同时安装 docker CLI 与 nerdctl：pixiu-upgrade 通过命令行（pull/stop/rm/run）重建 pixiu 容器
RUN apk add --no-cache ca-certificates tzdata docker-cli curl \
    && curl -fsSL "https://github.com/containerd/nerdctl/releases/download/v${NERDCTL_VERSION}/nerdctl-${NERDCTL_VERSION}-linux-${TARGETARCH}.tar.gz" -o /tmp/nerdctl.tar.gz \
    && tar -xzf /tmp/nerdctl.tar.gz -C /usr/local/bin nerdctl \
    && rm -f /tmp/nerdctl.tar.gz \
    && apk del curl
COPY --from=builder /app/upgrade /usr/local/bin/upgrade
ENTRYPOINT ["upgrade"]
